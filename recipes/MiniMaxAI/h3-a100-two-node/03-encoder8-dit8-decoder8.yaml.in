# Inherit the experimental three-stage decoder split; override placement and transport.
base_config: "__BASE_CONFIG__"

connectors:
  cross_host:
    name: MooncakeStoreConnector
    extra:
      host: "__NODE_IP__"
      metadata_server: "http://__MASTER_IP__:8080/metadata"
      master: "__MASTER_IP__:50051"
      segment: 512000000
      localbuf: 64000000
      proto: tcp

stages:
  - stage_id: 0
    devices: "0,1,2,3,4,5,6,7"
    tensor_parallel_size: 8
    gpu_memory_utilization: 0.3
    max_model_len: 6144
    enforce_eager: true
    output_connectors: {to_stage_1: cross_host}

  - stage_id: 1
    devices: "0,1,2,3,4,5,6,7"
    enforce_eager: true
    input_connectors: {from_stage_0: cross_host}
    output_connectors: {to_stage_2: cross_host}
    enable_distributed_layerwise_offload: true
    dlo_use_allgather: true
    parallel_config:
      ulysses_degree: 8
      vae_patch_parallel_size: 1
    default_sampling_params:
      num_inference_steps: 2

  - stage_id: 2
    devices: "0,1,2,3,4,5,6,7"
    enforce_eager: true
    input_connectors: {from_stage_1: cross_host}
    parallel_config:
      ulysses_degree: 8
      vae_patch_parallel_size: 8
